import { useEffect, useState, useRef, memo } from 'react';
import { useParams, useNavigate } from 'react-router-dom';
import { io, Socket } from 'socket.io-client';
import {
  Mic, MicOff, Video as VideoIcon, VideoOff, MonitorUp, MessageSquare,
  X, Users, Pin, Hand, Smile, Settings, Shield, UserMinus,
  Circle, StopCircle, Sparkles, Loader2, Send, Plus
} from 'lucide-react';
import { useAuthStore } from '../store/authStore';

interface VideoPlayerProps {
  stream: MediaStream | null;
  name: string;
  profilePic?: string;
  isMuted?: boolean;
  isVideoOff?: boolean;
  isLocal?: boolean;
  isSpeaking?: boolean;
  isHandRaised?: boolean;
  isScreenShare?: boolean;
}

const VideoPlayer = memo(({
  stream, name, profilePic,
  isMuted = false, isVideoOff = false,
  isLocal = false, isSpeaking = false,
  isHandRaised = false, isScreenShare = false
}: VideoPlayerProps) => {

  const videoRef = useRef<HTMLVideoElement>(null);

  useEffect(() => {
    if (videoRef.current && stream && stream.getTracks().length > 0) {
      videoRef.current.srcObject = stream;
      videoRef.current.play().catch(() => {});
    }
  }, [stream]);

  return (
    <div className={`relative w-full h-full rounded-2xl overflow-hidden border ${isSpeaking ? 'border-cyan-400' : 'border-white/10'}`}>
      {isVideoOff ? (
        <div className="flex items-center justify-center h-full bg-black">
          {profilePic ? <img src={profilePic} /> : name[0]}
        </div>
      ) : (
        <video ref={videoRef} autoPlay playsInline muted={isLocal || isMuted} className="w-full h-full object-cover"/>
      )}
      {isHandRaised && <div className="absolute top-2 left-2">✋</div>}
    </div>
  );
});

export default function MeetingRoom() {

  const { roomId } = useParams();
  const navigate = useNavigate();

  const user = useAuthStore((state: any) => state.user);

  const [socket, setSocket] = useState<Socket | null>(null);

  // 🔹 CORE STATES
  const [myStream, setMyStream] = useState<MediaStream | null>(null);
  const peersRef = useRef<{ [key: string]: RTCPeerConnection }>({});
  const [remoteStreams, setRemoteStreams] = useState<{ [key: string]: MediaStream }>({});
  const [peerNames, setPeerNames] = useState<{ [key: string]: string }>({});
  const [peerStatus, setPeerStatus] = useState<any>({});

  const [isMuted, setIsMuted] = useState(false);
  const [isVideoOff, setIsVideoOff] = useState(false);

  const [messages, setMessages] = useState<any[]>([]);
  const [chatInput, setChatInput] = useState('');

  const [sharedNotes, setSharedNotes] = useState('');
  const [meetingTasks, setMeetingTasks] = useState<any[]>([]);

  const [joinRequests, setJoinRequests] = useState<any[]>([]);
  const [roomRoles, setRoomRoles] = useState<any>({});
  const [myRole, setMyRole] = useState<'creator' | 'co-host' | 'guest'>('guest');

  const [globalPermissions, setGlobalPermissions] = useState({
    mic: true,
    video: true,
    screen: true,
    record: true,
    notes: true,
    tasks: true
  });

  const [isRecording, setIsRecording] = useState(false);
  const mediaRecorderRef = useRef<MediaRecorder | null>(null);

  const [showSidebar, setShowSidebar] = useState(false);
  const [activeTab, setActiveTab] = useState<'chat' | 'participants' | 'notes'>('chat');

  const [isGeneratingAI, setIsGeneratingAI] = useState(false);
  const [aiSummaryResult, setAiSummaryResult] = useState<string | null>(null);

  const [isHandRaised, setIsHandRaised] = useState(false);
  const [raisedHands, setRaisedHands] = useState<any>({});

  const [floatingEmojis, setFloatingEmojis] = useState<any[]>([]);

  const [localScreenStream, setLocalScreenStream] = useState<MediaStream | null>(null);

  const userName = user?.name || "Guest";

  // 🔹 SOCKET INIT
  useEffect(() => {

    const newSocket = io(import.meta.env.VITE_SOCKET_URL || 'http://localhost:5000');
    setSocket(newSocket);

    navigator.mediaDevices.getUserMedia({ video: true, audio: true })
      .then(stream => {
        setMyStream(stream);
      });

    newSocket.on('user-connected', ({ userId, userName }: any) => {

      setPeerNames(prev => ({ ...prev, [userId]: userName }));

      const pc = new RTCPeerConnection();
      peersRef.current[userId] = pc;

      myStream?.getTracks().forEach(track => pc.addTrack(track, myStream));

      pc.ontrack = (e) => {
        setRemoteStreams(prev => ({ ...prev, [userId]: e.streams[0] }));
      };

      pc.createOffer().then(offer => {
        pc.setLocalDescription(offer);
        newSocket.emit('offer', { target: userId, sdp: offer });
      });
    });

    newSocket.on('offer', async (data: any) => {
      const pc = new RTCPeerConnection();
      peersRef.current[data.caller] = pc;

      await pc.setRemoteDescription(new RTCSessionDescription(data.sdp));

      const answer = await pc.createAnswer();
      await pc.setLocalDescription(answer);

      newSocket.emit('answer', { target: data.caller, sdp: answer });

      pc.ontrack = (e) => {
        setRemoteStreams(prev => ({ ...prev, [data.caller]: e.streams[0] }));
      };
    });

    newSocket.on('answer', async (data: any) => {
      const pc = peersRef.current[data.caller];
      if (pc) await pc.setRemoteDescription(new RTCSessionDescription(data.sdp));
    });

    newSocket.on('receive-message', (msg) => {
      setMessages(prev => [...prev, msg]);
    });

    newSocket.on('participant-waiting', (data) => {
      setJoinRequests(prev => [...prev, data]);
    });

    newSocket.on('roles-updated', setRoomRoles);

    return () => {
      newSocket.disconnect();
      Object.values(peersRef.current).forEach(pc => pc.close());
    };

  }, []);

  // 🔹 CONTROLS

  const toggleMute = () => {
    const track = myStream?.getAudioTracks()[0];
    if (!track) return;

    track.enabled = !track.enabled;
    setIsMuted(!track.enabled);

    socket?.emit('media-status-change', {
      roomId,
      isMuted: !track.enabled,
      isVideoOff
    });
  };

  const toggleVideo = () => {
    const track = myStream?.getVideoTracks()[0];
    if (!track) return;

    track.enabled = !track.enabled;
    setIsVideoOff(!track.enabled);

    socket?.emit('media-status-change', {
      roomId,
      isMuted,
      isVideoOff: !track.enabled
    });
  };

  const sendMessage = (e: any) => {
    e.preventDefault();
    if (!chatInput) return;

    socket?.emit('send-message', {
      roomId,
      text: chatInput,
      sender: userName
    });

    setChatInput('');
  };

  const toggleRaiseHand = () => {
    const state = !isHandRaised;
    setIsHandRaised(state);

    socket?.emit('toggle-raise-hand', {
      roomId,
      isRaised: state
    });
  };

  const sendReaction = (emoji: string) => {
    setFloatingEmojis(prev => [...prev, { emoji }]);
    socket?.emit('send-reaction', { roomId, emoji });
  };

  // 🔹 RECORDING FIX (permission added)
  const startRecording = async () => {
    if (!globalPermissions.record) return alert("Recording disabled by host");

    const stream = await navigator.mediaDevices.getDisplayMedia({ video: true, audio: true });

    const recorder = new MediaRecorder(stream);
    mediaRecorderRef.current = recorder;

    recorder.start();
    setIsRecording(true);

    recorder.onstop = () => {
      setIsRecording(false);
    };
  };

  const stopRecording = () => {
    mediaRecorderRef.current?.stop();
  };

  // 🔹 AI SUMMARY
  const generateAISummary = async () => {
    setIsGeneratingAI(true);

    const res = await fetch('/api/summary', {
      method: 'POST',
      body: JSON.stringify({ roomId })
    });

    const data = await res.json();
    setAiSummaryResult(data.summary);

    setIsGeneratingAI(false);
  };
  

  // 🔹 PIN LOGIC
  const [pinnedUserId, setPinnedUserId] = useState<string | null>(null);

  const allPeerIds = Object.keys(peerNames);

  const displayPinnedId = pinnedUserId;

  return (
    <div className="fixed inset-0 bg-[#020617] text-white flex flex-col">

      {/* 🔹 TOP BAR */}
      <div className="flex justify-between items-center px-4 py-3 bg-white/5 backdrop-blur-xl border-b border-white/10">

        {/* LEFT */}
        <div className="flex items-center gap-3">
          <span className="text-sm text-slate-400">Room:</span>
          <span className="font-bold text-cyan-400">{roomId}</span>

          {myRole === 'creator' && (
            <span className="bg-blue-500 text-xs px-2 py-0.5 rounded">Host</span>
          )}
          {myRole === 'co-host' && (
            <span className="bg-yellow-500 text-xs px-2 py-0.5 rounded">Co-Host</span>
          )}
        </div>

        {/* RIGHT */}
        <div className="flex items-center gap-2">

          {/* ✅ AI SUMMARY BUTTON (FIXED) */}
          <button
            onClick={generateAISummary}
            disabled={isGeneratingAI}
            className="bg-purple-600 px-3 py-1 rounded text-sm flex items-center gap-1"
          >
            {isGeneratingAI ? <Loader2 className="animate-spin" size={14}/> : <Sparkles size={14}/>}
            AI Summary
          </button>

          {/* HOST ONLY */}
          {myRole === 'creator' && (
            <button className="bg-red-600 px-3 py-1 rounded text-sm">
              End Meeting
            </button>
          )}

          <button onClick={() => setShowSidebar(!showSidebar)} className="bg-slate-700 p-2 rounded">
            <MessageSquare size={16}/>
          </button>

          <button className="bg-slate-700 p-2 rounded">
            <Shield size={16}/>
          </button>

          <button className="bg-slate-700 p-2 rounded">
            <Settings size={16}/>
          </button>
        </div>
      </div>

      {/* 🔹 VIDEO AREA */}
      <div className="flex-1 flex overflow-hidden p-3 gap-3">

        {/* 🔸 PINNED */}
        {displayPinnedId && (
          <div
            className="flex-1 relative rounded-xl overflow-hidden border border-white/10 cursor-pointer"
            onClick={() => setPinnedUserId(null)}
          >
            <VideoPlayer
              stream={remoteStreams[displayPinnedId]}
              name={peerNames[displayPinnedId]}
              isMuted={peerStatus[displayPinnedId]?.isMuted}
            />
            <div className="absolute top-2 right-2 bg-black/60 px-2 py-1 text-xs rounded">
              Click to unpin
            </div>
          </div>
        )}

        {/* 🔸 GRID */}
        <div className={`grid gap-2 ${displayPinnedId ? 'w-64 grid-cols-1' : 'flex-1 grid-cols-3'}`}>

          {/* LOCAL */}
          {!displayPinnedId && (
            <div
              className="cursor-pointer"
              onClick={() => setPinnedUserId('local')}
            >
              <VideoPlayer
                stream={myStream}
                name={`${userName} (You)`}
                isMuted={isMuted}
                isVideoOff={isVideoOff}
                isLocal
                isHandRaised={isHandRaised}
              />
            </div>
          )}

          {/* REMOTE */}
          {allPeerIds.map(id => (
            <div key={id} onClick={() => setPinnedUserId(id)} className="cursor-pointer">
              <VideoPlayer
                stream={remoteStreams[id]}
                name={peerNames[id]}
                isMuted={peerStatus[id]?.isMuted}
              />
            </div>
          ))}

        </div>
      </div>

      {/* 🔹 SCREEN SHARE INDICATOR */}
      {localScreenStream && (
        <div className="absolute top-16 left-1/2 -translate-x-1/2 bg-blue-600 px-4 py-1 rounded text-sm shadow">
          You are presenting
        </div>
      )}

      {/* 🔹 CONTROLS */}
      <div className="absolute bottom-5 left-1/2 -translate-x-1/2 flex gap-3 bg-slate-800 px-5 py-3 rounded-full shadow-lg">

        {/* MIC */}
        <button onClick={toggleMute} className={`p-3 rounded-full ${isMuted ? 'bg-red-500' : 'bg-slate-600'}`}>
          {isMuted ? <MicOff/> : <Mic/>}
        </button>

        {/* VIDEO */}
        <button onClick={toggleVideo} className={`p-3 rounded-full ${isVideoOff ? 'bg-red-500' : 'bg-slate-600'}`}>
          {isVideoOff ? <VideoOff/> : <VideoIcon/>}
        </button>

        {/* HAND */}
        <button onClick={toggleRaiseHand} className={`p-3 rounded-full ${isHandRaised ? 'bg-blue-500' : 'bg-slate-600'}`}>
          <Hand/>
        </button>

        {/* REACTION */}
        <button onClick={() => sendReaction('👍')} className="p-3 rounded-full bg-slate-600">
          <Smile/>
        </button>

        {/* SCREEN SHARE */}
        <button className="p-3 rounded-full bg-slate-600">
          <MonitorUp/>
        </button>

        {/* ✅ RECORD BUTTON (FIXED + PERMISSION) */}
        <button
          onClick={() => isRecording ? stopRecording() : startRecording()}
          className={`p-3 rounded-full ${isRecording ? 'bg-red-600 animate-pulse' : 'bg-slate-600'}`}
        >
          {isRecording ? <StopCircle/> : <Circle/>}
        </button>

      </div>

      {/* 🔹 AI MODAL */}
      {aiSummaryResult && (
        <div className="fixed inset-0 flex items-center justify-center bg-black/80 z-50">
          <div className="bg-slate-900 p-6 rounded-xl w-[400px]">
            <h2 className="text-lg mb-3">AI Summary</h2>
            <p className="text-sm">{aiSummaryResult}</p>
            <button onClick={() => setAiSummaryResult(null)} className="mt-4 bg-purple-600 px-3 py-1 rounded">
              Close
            </button>
          </div>
        </div>
      )}

    </div>
  );
}

{/* 🔹 SIDEBAR */}
{showSidebar && (
  <div className="fixed right-0 top-0 h-full w-[350px] bg-slate-900 border-l border-white/10 z-50 flex flex-col">

    {/* HEADER */}
    <div className="flex justify-between items-center p-4 border-b border-white/10">
      <div className="flex gap-2">
        <button onClick={() => setActiveTab('chat')} className={activeTab === 'chat' ? 'text-blue-400' : ''}>Chat</button>
        <button onClick={() => setActiveTab('participants')} className={activeTab === 'participants' ? 'text-blue-400' : ''}>People</button>
        <button onClick={() => setActiveTab('notes')} className={activeTab === 'notes' ? 'text-blue-400' : ''}>Notes</button>
      </div>
      <button onClick={() => setShowSidebar(false)}><X/></button>
    </div>

    {/* 🔹 CHAT */}
    {activeTab === 'chat' && (
      <div className="flex flex-col flex-1">

        <div className="flex-1 overflow-y-auto p-3 space-y-2">
          {messages.map((msg, i) => (
            <div key={i} className="bg-slate-800 p-2 rounded">
              <strong>{msg.sender}</strong>
              <p>{msg.text}</p>
            </div>
          ))}
        </div>

        <form onSubmit={sendMessage} className="p-3 flex gap-2">
          <input
            value={chatInput}
            onChange={(e) => setChatInput(e.target.value)}
            className="flex-1 bg-slate-800 p-2 rounded"
          />
          <button className="bg-blue-600 px-3 rounded"><Send/></button>
        </form>

      </div>
    )}

    {/* 🔹 PARTICIPANTS */}
    {activeTab === 'participants' && (
      <div className="flex-1 overflow-y-auto p-3 space-y-3">

        {/* JOIN REQUESTS (HOST ONLY) */}
        {myRole === 'creator' && joinRequests.length > 0 && (
          <div>
            <h3 className="text-sm mb-2">Join Requests</h3>
            {joinRequests.map((req, i) => (
              <div key={i} className="bg-slate-800 p-2 rounded flex justify-between items-center">
                <span>{req.userName}</span>
                <div className="flex gap-2">
                  <button
  onClick={() => handleApproveJoin(req)}
  className="bg-green-600 px-2 py-1 text-xs"
>
  Accept
</button>

<button
  onClick={() => handleRejectJoin(req)}
  className="bg-red-600 px-2 py-1 text-xs"
>
  Reject
</button>
                </div>
              </div>
            ))}
          </div>
        )}

        {/* PARTICIPANT LIST */}
        <h3 className="text-sm">Participants</h3>

        {/* LOCAL USER */}
        <div className="bg-slate-800 p-2 rounded flex justify-between items-center">
          <span>{userName} (You)</span>
        </div>

        {/* REMOTE USERS */}
        {Object.keys(peerNames).map(id => (
          <div key={id} className="bg-slate-800 p-2 rounded flex justify-between items-center">

            <span>{peerNames[id]}</span>

            {/* ROLE CONTROLS */}
            {(myRole === 'creator' || myRole === 'co-host') && (
              <div className="flex gap-2">

                {/* PROMOTE */}
                {roomRoles[id] !== 'co-host' && (
                  <button className="bg-yellow-500 px-2 text-xs">Promote</button>
                )}

                {/* REMOVE */}
                <button className="bg-red-600 px-2 text-xs">
                  <UserMinus size={14}/>
                </button>

              </div>
            )}
          </div>
        ))}

      </div>
    )}

    {/* 🔹 NOTES + TASKS */}
    {activeTab === 'notes' && (
      <div className="flex flex-col flex-1 p-3 gap-3">

        {/* NOTES */}
        <textarea
          value={sharedNotes}
          onChange={(e) => {
            setSharedNotes(e.target.value);
            socket?.emit('update-notes', { roomId, notes: e.target.value });
          }}
          className="bg-slate-800 p-3 rounded h-[150px]"
          placeholder="Shared notes..."
        />

        {/* TASK ADD */}
        <form
          onSubmit={(e) => {
            e.preventDefault();
            if (!chatInput) return;

            const task = {
              id: Date.now(),
              text: chatInput,
              creator: userName
            };

            setMeetingTasks(prev => [...prev, task]);

            socket?.emit('add-task', { roomId, task });

            setChatInput('');
          }}
          className="flex gap-2"
        >
          <input
            value={chatInput}
            onChange={(e) => setChatInput(e.target.value)}
            className="flex-1 bg-slate-800 p-2 rounded"
            placeholder="New task"
          />
          <button className="bg-green-600 px-3 rounded"><Plus/></button>
        </form>

        {/* TASK LIST */}
        <div className="flex-1 overflow-y-auto space-y-2">
          {meetingTasks.map((task, i) => (
            <div key={i} className="bg-slate-800 p-2 rounded">
              <p>{task.text}</p>
              <span className="text-xs text-slate-400">by {task.creator}</span>
            </div>
          ))}
        </div>

      </div>
    )}

  </div>
)}

// 🔹 JOIN REQUEST ACTIONS (HOST)
const handleApproveJoin = (req: any) => {
  socket?.emit('approve-join', {
    roomId,
    socketId: req.socketId,
    role: 'guest'
  });

  setJoinRequests(prev => prev.filter(r => r.socketId !== req.socketId));
};

const handleRejectJoin = (req: any) => {
  socket?.emit('reject-join', {
    roomId,
    socketId: req.socketId
  });

  setJoinRequests(prev => prev.filter(r => r.socketId !== req.socketId));
};


// 🔹 ROLE MANAGEMENT
const promoteToCoHost = (userId: string) => {
  socket?.emit('change-role', {
    roomId,
    userId,
    role: 'co-host'
  });
};

const removeParticipant = (userId: string) => {
  socket?.emit('kick-user', {
    roomId,
    userId
  });
};


// 🔹 SCREEN SHARE (FIXED TRIGGER)
const toggleScreenShare = async () => {

  if (!globalPermissions.screen) {
    alert("Screen sharing disabled by host");
    return;
  }

  if (localScreenStream) {
    localScreenStream.getTracks().forEach(t => t.stop());
    setLocalScreenStream(null);
    return;
  }

  try {
    const stream = await navigator.mediaDevices.getDisplayMedia({
      video: true,
      audio: true
    });

    setLocalScreenStream(stream);

    stream.getVideoTracks()[0].onended = () => {
      setLocalScreenStream(null);
    };

  } catch (err) {
    console.error(err);
  }
};


// 🔹 RECORD BUTTON OPEN MODAL (IF YOU USE MODAL)
const handleRecordClick = () => {
  if (!globalPermissions.record) {
    alert("Recording disabled by host");
    return;
  }

  // If using modal:
  // setShowRecordModal(true);

  // fallback:
  isRecording ? stopRecording() : startRecording();
};


// 🔹 SOCKET EVENTS (CRITICAL FIXES)
useEffect(() => {

  if (!socket) return;

  socket.on('join-approved', () => {
    console.log("Joined meeting");
  });

  socket.on('join-denied', () => {
    alert("Host rejected your request");
    navigate('/dashboard');
  });

  socket.on('kicked-out', () => {
    alert("You were removed from meeting");
    navigate('/dashboard');
  });

  socket.on('role-changed', (role) => {
    setMyRole(role);
  });

  socket.on('permissions-updated', (perms) => {
    setGlobalPermissions(perms);
  });

  socket.on('meeting-ended-by-host', () => {
    alert("Meeting ended");
    navigate('/summary/' + roomId);
  });

  return () => {
    socket.off('join-approved');
    socket.off('join-denied');
    socket.off('kicked-out');
    socket.off('role-changed');
    socket.off('permissions-updated');
    socket.off('meeting-ended-by-host');
  };

}, [socket]);


// 🔹 CLEANUP (FINAL SAFETY)
useEffect(() => {
  return () => {
    myStream?.getTracks().forEach(t => t.stop());
    localScreenStream?.getTracks().forEach(t => t.stop());
    Object.values(peersRef.current).forEach(pc => pc.close());
  };
}, []);
